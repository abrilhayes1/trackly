# Modo prototipo (npm run prototipo): la app funciona sola, con datos de ejemplo y sin servidor.
# Estas direcciones no se usan; solo evitan el aviso de "falta configurar la aplicación".
VITE_DEMO=1
VITE_SUPABASE_URL=https://prototipo.local
VITE_SUPABASE_ANON_KEY=prototipo
VITE_API_URL=https://prototipo.local
