classDiagram
    direction LR

    class Equipo {
        +String nombre
        +String plan
        +int licencias
        +licenciasLibres() int
        +invitar(email)
    }
    class ConfiguracionEquipo {
        +String rubro
        +String terminoContacto
        +String terminoContactoPlural
        +boolean vencimientoHabilitado
        +int diasVencimiento
        +int diasAlertaPrevia
        +int diasArchivo
        +boolean diasHabiles
        +String[] categoriasOrigen
        +boolean eventosHabilitado
        +String terminoEvento
        +boolean emailDiario
        +String[] motivosPerdida
    }
    class CampoCierre {
        +String nombre
        +TipoCampo tipo
        +boolean obligatorio
        +String[] opciones
    }
    class Usuario {
        +String nombre
        +String email
        +Rol rol
        +String foto
        +boolean activo
        +boolean historico
        +Date desactivadoEn
        +desactivar()
        +reactivar()
        +cambiarRol(rol)
    }
    class Invitacion {
        +String email
        +Rol rol
        +Date creadaEn
        +Date aceptadaEn
        +aceptar()
        +rechazar()
    }
    class Lead {
        +String nombre
        +String telefono
        +String email
        +String[] emailsExtra
        +String origen
        +String consulta
        +NivelInteres interes
        +EstadoLead estado
        +boolean destacado
        +Date fechaIngreso
        +Date ultimoContacto
        +Date recordatorio
        +Date vencidoEn
        +Date archivadoEn
        +registrarContacto()
        +programarRecordatorio(fecha)
        +cerrar(tipo, datos, motivo)
        +reclamar(asesor)
        +reactivar(asesor)
        +reasignar(asesor)
        +diasSinContacto() int
    }
    class EntradaHistorial {
        +String texto
        +Date fecha
    }
    class Recordatorio {
        +Date fecha
        +Time hora
        +String contacto
        +String nota
        +boolean hecho
        +completar()
    }
    class Cierre {
        +TipoCierre tipo
        +Map datos
        +String motivo
        +Date fecha
        +editar(tipo, datos, motivo)
    }
    class Charla {
        +String nombre
        +String categoria
        +Date fecha
        +String link
        +invitar(lead)
    }
    class InvitacionCharla {
        +Boolean asistio
        +Date fechaNotificacion
        +marcarAsistencia(asistio)
    }
    class Plantilla {
        +String nombre
        +Canal canal
        +String asunto
        +String texto
        +boolean compartida
        +completarPara(lead) String
    }
    class Reporte {
        +String nombre
        +Map definicion
        +boolean compartido
        +calcular() Resultado
    }

    class Rol {
        <<enumeration>>
        ASESOR
        LIDER
    }
    class EstadoLead {
        <<enumeration>>
        ACTIVO
        VENCIDO
        ARCHIVO
        GANADO
        PERDIDO
    }
    class NivelInteres {
        <<enumeration>>
        MUY_INTERESADO
        INTERESADO
        DUDA
        POCO_INTERESADO
        FRIO
        NO_INTERESADO
    }
    class TipoCierre {
        <<enumeration>>
        GANADO
        PERDIDO
    }
    class Canal {
        <<enumeration>>
        WHATSAPP
        EMAIL
        AMBOS
    }
    class TipoCampo {
        <<enumeration>>
        TEXTO
        NUMERO
        LISTA
    }

    Equipo "1" *-- "1" ConfiguracionEquipo : se configura con
    ConfiguracionEquipo "1" *-- "0..*" CampoCierre : pide al ganar
    Equipo "1" o-- "1..*" Usuario : integra
    Equipo "1" *-- "0..*" Invitacion : tiene pendientes
    Usuario "1" --> "0..*" Invitacion : envía
    Equipo "1" *-- "0..*" Lead : gestiona
    Usuario "0..1" --> "0..*" Lead : es asesor de
    Lead "1" *-- "0..*" EntradaHistorial : registra
    Usuario "0..1" --> "0..*" EntradaHistorial : escribe
    Usuario "1" --> "0..*" Recordatorio : agenda
    Recordatorio "0..*" --> "0..1" Lead : sobre
    Lead "1" *-- "0..1" Cierre : termina en
    Usuario "1" --> "0..*" Cierre : registra
    Equipo "1" *-- "0..*" Charla : organiza
    Charla "1" *-- "0..*" InvitacionCharla : convoca
    InvitacionCharla "0..*" --> "1" Lead : invitado
    Usuario "1" --> "0..*" Plantilla : crea
    Usuario "1" --> "0..*" Reporte : crea
