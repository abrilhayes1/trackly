@startuml
hide circle
hide empty methods
skinparam classAttributeIconSize 0

enum Rol {
  asesor
  lider
}

enum EstadoLead {
  activo
  vencido
  archivo
  ganado
  perdido
}

enum NivelInteres {
  muy interesado
  interesado
  duda
  poco interesado
  frio
  no interesado
}

enum TipoCierre {
  ganado
  perdido
}

enum TipoCampo {
  texto
  numero
  lista
}

enum CanalPlantilla {
  whatsapp
  email
  ambos
}

class Equipo {
  nombre : texto
  plan : texto
  licencias : entero
}

class ConfiguracionEquipo {
  rubro : texto
  terminoContacto : texto
  terminoContactoPlural : texto
  categoriasOrigen : texto [0..*]
  vencimientoHabilitado : booleano
  diasVencimiento : entero
  diasAvisoPrevio : entero
  diasArchivo : entero
  diasHabiles : booleano
  eventosHabilitado : booleano
  terminoEvento : texto
  emailDiario : booleano
  motivosPerdida : texto [0..20]
}

class CampoCierre {
  nombre : texto
  tipo : TipoCampo
  obligatorio : booleano
  opciones : texto [0..30]
}

class Usuario {
  nombre : texto
  email : texto
  rol : Rol
  foto : texto
  activo : booleano
  historico : booleano
  fechaDesactivacion : fechaHora
}

class Invitacion {
  email : texto
  rol : Rol
  fechaEnvio : fechaHora
  fechaAceptacion : fechaHora
}

class Lead {
  nombre : texto
  telefono : texto
  emailPrincipal : texto
  emailsAdicionales : texto [0..10]
  origen : texto
  consulta : texto
  interes : NivelInteres
  estado : EstadoLead
  destacado : booleano
  fechaIngreso : fechaHora
  ultimoContacto : fechaHora
  proximoContacto : fechaHora
  fechaVencimiento : fechaHora
  fechaArchivo : fechaHora
}

class EntradaHistorial {
  texto : texto
  fechaHora : fechaHora
}

class Recordatorio {
  fecha : fecha
  hora : hora
  contacto : texto
  nota : texto
  hecho : booleano
}

class Cierre {
  tipo : TipoCierre
  datos : valores de los CampoCierre
  motivo : texto
  fechaHora : fechaHora
}

class Evento {
  nombre : texto
  categoria : texto
  fechaHora : fechaHora
  enlace : texto
}

class InvitacionEvento {
  fechaInvitacion : fechaHora
  asistio : booleano
}

class Plantilla {
  nombre : texto
  canal : CanalPlantilla
  asunto : texto
  texto : texto
  compartida : booleano
}

class Reporte {
  nombre : texto
  definicion : texto
  compartido : booleano
}

' Equipo y su configuración
Equipo "1" *-- "1" ConfiguracionEquipo
ConfiguracionEquipo "1" *-- "0..15" CampoCierre

' Miembros
Equipo "1" -- "1..*" Usuario : pertenece
Equipo "1" -- "0..*" Invitacion : emite
Usuario "0..1" -- "0..*" Invitacion : invita

' Leads
Equipo "1" -- "0..*" Lead : gestiona
Usuario "0..1" -- "0..*" Lead : asesor asignado
Lead "1" *-- "0..*" EntradaHistorial : historial
Usuario "0..1" -- "0..*" EntradaHistorial : autor
Lead "1" *-- "0..1" Cierre
Usuario "0..1" -- "0..*" Cierre : cerrado por

' Agenda
Usuario "1" -- "0..*" Recordatorio : agenda
Lead "0..1" -- "0..*" Recordatorio : sobre

' Eventos
Equipo "1" -- "0..*" Evento : organiza
Evento "0..*" -- "0..*" Lead : invitados
(Evento, Lead) .. InvitacionEvento
Usuario "0..1" -- "0..*" InvitacionEvento : invitó

' Plantillas y reportes
Usuario "1" -- "0..*" Plantilla : crea
Usuario "1" -- "0..*" Reporte : crea

@enduml
