    end

    subgraph github["GitHub"]
        ci["Repositorio + GitHub Actions<br/>(tests, lint, build)"]
    end

    usuario --> web
    usuario --> app
    web -->|"HTTPS: descarga la app"| estaticos
    web -->|"HTTPS: ingresar, crear cuenta, recuperar"| auth
    app -->|"HTTPS: ingresar"| auth
    web -->|"HTTPS REST/JSON + token de sesión"| api
    app -->|"HTTPS REST/JSON + token de sesión"| api
    api -->|"valida el token"| auth
    api -->|"consultas y funciones SQL con el token del usuario"| db
    api -->|"sube y borra fotos"| storage
    auth -->|"OAuth 2.0"| google
    cron -->|"procesar_vencimientos() 00:05"| db
    web -.->|"abre el chat"| whatsapp
    web -.->|"abre el correo"| gmail
    app -.->|"abre el chat"| whatsapp
