@startuml
title Trackly - Diseño de la arquitectura
skinparam componentStyle rectangle

actor "Asesor / Líder" as usuario

node "Computadora (navegador)" as pc {
  [Aplicación web\nReact 19 + Vite + Tailwind\n(SPA)] as web
}

node "Celular Android / iPhone" as cel {
  [Aplicación mobile\nReact Native + Expo SDK 58] as app
}

cloud "Vercel" as vercel {
  [Archivos de la web\n(HTML, JS, CSS)] as estaticos
}

cloud "Railway" as railway {
  [API REST\nNode.js + Express 5] as api
}

cloud "Supabase" as supabase {
  [Supabase Auth\n(email/contraseña y Google)] as auth
  database "PostgreSQL\n(RLS por equipo, funciones SQL, triggers)" as db
  [Supabase Storage\n(fotos de perfil)] as storage
  [pg_cron\n(vencimientos de cada noche)] as cron
}

cloud "Servicios externos" as externos {
  [Google OAuth] as google
  [WhatsApp (wa.me)] as whatsapp
  [Gmail (redactar correo)] as gmail
}

cloud "GitHub" as github {
  [Repositorio + GitHub Actions\n(tests, lint, build)] as ci
}

usuario --> web
usuario --> app
web --> estaticos : HTTPS\n(descarga la app)
web --> auth : HTTPS\n(ingresar, crear cuenta, recuperar)
app --> auth : HTTPS\n(ingresar)
web --> api : HTTPS REST/JSON\n+ token de sesión (JWT)
app --> api : HTTPS REST/JSON\n+ token de sesión (JWT)
api --> auth : valida el token\n(clave pública)
api --> db : consultas y funciones SQL\ncon el token del usuario
api --> storage : sube y borra fotos
auth --> google : OAuth 2.0
cron --> db : procesar_vencimientos()\n00:05 (Argentina)
web ..> whatsapp : abre el chat
web ..> gmail : abre el correo
app ..> whatsapp : abre el chat
ci ..> estaticos : despliegue al hacer push
ci ..> api : despliegue al hacer push

@enduml
