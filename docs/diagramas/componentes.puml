@startuml
title Trackly - Diseño de componentes
skinparam componentStyle uml2

package "Aplicación web (frontend)" {
  [App\n(sesión, perfil, navegación\npor dirección)] as App
  [Páginas\n(Mis leads, Alertas, Agenda, Archivo,\nCerrados, Charlas, Estadísticas, Reportes,\nPanel del equipo, Configuración, Perfil,\nOnboarding, Login, Landing, Legal)] as Paginas
  [Componentes de interfaz\n(DetalleLead, LeadCard, ImportarLeads,\nRecordatorioModal, CierreLead, FiltroAsesor,\nInvitaciones, Sidebar, Topbar...)] as UI
  [Contextos compartidos\n(ConfigEquipo, LeadsEquipo)] as Contextos
  [Lógica de negocio compartida (lib)\n(urgencia, alertas, agenda, contadores,\nestadísticas, reportes, importar,\nplantillas, miembros, navegación)] as Logica
  [Cliente API\n(apiFetch)] as ClienteApi
  [Cliente de autenticación\n(supabase-js)] as ClienteAuth
}

package "Aplicación mobile" {
  [Pantallas\n(Expo Router)] as Pantallas
  [Componentes mobile\n(Hoja, Formulario, FilaLead...)] as UIMobile
  [Proveedor de sesión\n(SesionProvider)] as SesionMobile
  [Cliente API mobile] as ApiMobile
}

package "Backend (API REST)" {
  [Middleware\n(encabezados, límite de pedidos,\nrequireAuth, manejo de errores)] as Middleware
  [Rutas\n(/api/leads, /api/me, /api/config,\n/api/cierres, /api/recordatorios,\n/api/charlas, /api/reportes,\n/api/plantillas, /api/onboarding)] as Rutas
  [Controladores] as Controladores
  [Servicios\n(reglas de negocio y consultas)] as Servicios
  [Utilidades\n(errores, historial, validaciones)] as Utilidades
}

package "Supabase" {
  [Auth] as Auth
  [PostgREST + RPC] as PostgREST
  [Funciones SQL y triggers\n(cerrar, reclamar, reasignar, importar,\nlicencias, vencimientos...)] as Funciones
  [Reglas RLS\n(aislamiento por equipo y rol)] as RLS
  database "Tablas" as Tablas
  [Storage] as Storage
}

interface "API REST /api/*" as IApi
interface "API de autenticación" as IAuth

App --> Paginas
App --> Contextos
Paginas --> UI
Paginas --> Contextos
Paginas --> Logica
UI --> Logica
Paginas --> ClienteApi
UI --> ClienteApi
App --> ClienteAuth
ClienteApi ..> ClienteAuth : token de sesión

Pantallas --> UIMobile
Pantallas --> SesionMobile
Pantallas --> Logica : reutiliza
SesionMobile --> ApiMobile

ClienteApi --> IApi
ApiMobile --> IApi
ClienteAuth --> IAuth
SesionMobile --> IAuth

IApi -- Middleware
Middleware --> Rutas
Rutas --> Controladores
Controladores --> Servicios
Servicios --> Utilidades
Middleware ..> Auth : valida el token
Servicios --> PostgREST
Servicios --> Storage

IAuth -- Auth
PostgREST --> Funciones
PostgREST --> RLS
RLS --> Tablas
Funciones --> Tablas

@enduml
